diff --git a/.bazelrc b/.bazelrc
index e3915bc..6d43e5a 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -194,6 +194,27 @@ build:release_linux --linkopt="-Wl,-O2"
 build:release_macos --config=release_unix
 build:release_macos --linkopt="-Wl,-no_data_in_code_info"
 build:release_macos --linkopt="-Wl,-no_function_starts"
+
+# --- Android ARM64 Bionic libc configuration ---
+# Disables TCMalloc to support 39-bit virtual address (VA) space on Android kernels
+# Enforces Bionic libc API 29 compatibility and system allocator fallback
+build:android --config=unix
+build:android --@workerd//src/workerd/server:use_tcmalloc=False
+build:android --@v8//:v8_use_perfetto=False
+build:android --copt=-D__ANDROID__
+build:android --copt=-D__ANDROID_API__=29
+build:android --copt=-D_GNU_SOURCE
+build:android --copt=-fPIC
+build:android --linkopt=-fuse-ld=lld
+build:android --linkopt=-Wl,-z,nocopyreloc
+build:android --linkopt=-Wl,--hash-style=both
+build:android --linkopt=-llog
+build:android --strip=always
+
+build:release_android --config=release_unix
+build:release_android --config=android
+build:release_android --linkopt="-Wl,-O2"
+
 # Cross-compiled release build for x86_64.
 build:release_linux_x86_64 --config=release_linux
 build:release_linux_x86_64 --platforms=@toolchains_llvm//platforms:linux-x86_64
