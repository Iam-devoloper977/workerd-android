 };
 
 const maybeExeExtension = process.platform === "win32" ? ".exe" : "";
@@ -59,6 +60,18 @@ export function downloadedBinPath(pkg: string, subpath: string): string {
 }
 
 export function generateBinPath(): { binPath: string } {
+  if (process.env.WRANGLER_WORKERD_BINARY && fs.existsSync(process.env.WRANGLER_WORKERD_BINARY)) {
+    return { binPath: process.env.WRANGLER_WORKERD_BINARY };
+  }
+  if (process.env.MINIFLARE_WORKERD_PATH && fs.existsSync(process.env.MINIFLARE_WORKERD_PATH)) {
+    return { binPath: process.env.MINIFLARE_WORKERD_PATH };
+  }
+  if (process.platform === "android") {
+    const termuxFallback = path.join(process.env.HOME || "", ".local", "bin", "workerd");
+    if (fs.existsSync(termuxFallback)) {
+      return { binPath: termuxFallback };
+    }
+  }
   const { pkg, subpath } = pkgAndSubpathForCurrentPlatform();
   let binPath: string;
 
